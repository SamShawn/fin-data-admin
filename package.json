{
  "name": "fin-data-admin",
  "version": "0.2.0",
  "private": true,
  "description": "金融数据后台管理系统",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.0.0",
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@fin/eslint-config": "workspace:*",
    "eslint": "^8.57.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.2.0",
    "tsx": "^4.23.15",
    "turbo": "^2.11.7",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "overrides": {
      "typescript": "5.9.3"
    }
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:cov": "turbo run test:cov",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "db:shell": "docker exec -it fin-postgres psql -U fin -d fin_data",
    "db:seed:large": "tsx apps/api/src/scripts/seed-market.ts",
    "infra:up": "docker compose -f infra/docker/docker-compose.dev.yml --env-file .env up -d",
    "infra:down": "docker compose -f infra/docker/docker-compose.dev.yml --env-file .env down",
    "infra:logs": "docker compose -f infra/docker/docker-compose.dev.yml logs -f",
    "prepare": "husky && turbo run build"
  },
  "lint-staged": {
    "apps/*/src/**/*.{ts,tsx}": [
      "eslint --fix"
    ],
    "*.{ts,tsx,json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
